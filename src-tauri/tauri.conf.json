{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Extrovert",
  "version": "0.1.0",
  "identifier": "im.extrovert.mobile",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Extrovert",
        "width": 480,
        "height": 800,
        "resizable": true,
        "minWidth": 360,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; connect-src 'self' https://extrovert.redforged.eu wss://extrovert.redforged.eu ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["im.extrovert.native"]
      },
      "mobile": [
        { "scheme": ["im.extrovert.native"] }
      ]
    }
  }
}
